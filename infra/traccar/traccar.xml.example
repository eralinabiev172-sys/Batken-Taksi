<?xml version="1.0" encoding="UTF-8"?>
<!-- BusWay KG: example Traccar configuration. Copy to traccar.xml and replace placeholders. -->
<!-- Do not commit real secrets. Traccar runs as an isolated GPS gateway (D-101, D-114). -->
<!-- Compatible with Traccar 6.x; pin the image tag to a specific version in compose. -->
<properties>
  <entry key="database.driver">org.postgresql.Driver</entry>
  <entry key="database.url">jdbc:postgresql://db:5432/traccar</entry>
  <entry key="database.user">traccar</entry>
  <entry key="database.password">change-me</entry>

  <entry key="web.port">8082</entry>
  <!-- Bind inside container to all interfaces so the loopback-only published port works. -->
  <entry key="web.address">0.0.0.0</entry>

  <!-- Disable auto-registration of unknown devices. -->
  <entry key="devices.autoRegistration">false</entry>
  <!-- Device commands disabled in MVP (D-122). -->
  <entry key="commands.queue">false</entry>

  <!-- Forwarding to Fastify (verified against a real Traccar 6.6 container, synthetic data):
       - Traccar POSTs {"position":{...},"device":{...}}; position.id is always 0 at forward time,
         so BusWay builds its dedupe key from deviceId + fixTime.
       - forward.header is sent as an HTTP header exactly as written ("Name: value").
       - The numeric Traccar deviceId must be registered in BusWay (gps_devices.traccar_device_id).
       - Use the same secret as INTERNAL_GPS_SECRET. Never commit the real value. -->
  <entry key="forward.url">http://host.docker.internal:3001/internal/v1/gps/traccar</entry>
  <entry key="forward.type">json</entry>
  <entry key="forward.header">X-Gateway-Secret: change-me-gateway-secret</entry>
  <entry key="forward.retry.enable">true</entry>
  <entry key="forward.retry.delay">500</entry>
  <entry key="forward.retry.count">5</entry></properties>