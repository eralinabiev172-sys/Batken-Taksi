# BusWay KG local development environment. Copy to .env and replace every "change-me".
# .env is ignored by Git. Never commit real passwords.
#
# Connection profile (D-137): the API and the test guard accept ONLY 127.0.0.1:5432.
# Database names and roles are fixed: busway/busway_app (application), busway/busway_migrator
# (migrations), busway_test (tests only). Other hosts, ports, databases or roles are refused.
#
# Passwords inside the URLs below must be percent-encoded when they contain reserved
# characters: @ : / ? # % space and any non-ASCII character
# (for example p@ss/word -> p%40ss%2Fword). Unencoded / ? # % or spaces are rejected.
# Passwords made only of letters and digits (e.g. generated hex) need no encoding.

# Database container (docker-compose.yml). Loopback only.
# BUSWAY_DB_PORT is NOT a free choice: the API, migrations and tests accept only 5432, so
# any other value makes the connection profile invalid until a new profile is approved.
BUSWAY_DB_PORT=5432
BUSWAY_DB_ADMIN_PASSWORD=change-me
BUSWAY_MIGRATOR_PASSWORD=change-me
BUSWAY_APP_PASSWORD=change-me

# API (apps/api). The application connects as busway_app.
# DB_POOL_MAX: 1-10 (PostgreSQL max_connections=30, 3 reserved for superusers).
# Multiply by the number of API instances when you run more than one.
# PG* environment variables (PGOPTIONS, PGAPPNAME, ...) are ignored by the pool;
# PGREPLICATION cannot be neutralised by pool settings, so the API refuses to start when it is set.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
DB_POOL_MAX=5
DATABASE_URL=postgres://busway_app:change-me@127.0.0.1:5432/busway

# Migrations connect as busway_migrator (DDL rights).
MIGRATOR_DATABASE_URL=postgres://busway_migrator:change-me@127.0.0.1:5432/busway

# Scratch database used only by automated tests.
TEST_DATABASE_URL=postgres://busway_app:change-me@127.0.0.1:5432/busway_test
TEST_MIGRATOR_DATABASE_URL=postgres://busway_migrator:change-me@127.0.0.1:5432/busway_test
